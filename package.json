{
  "name": "design-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && npm run specimens && npm run flora && npm run aquarium && npm run sea && next dev",
    "build": "npm run images && npm run specimens && npm run flora && npm run aquarium && npm run sea && npm run og && next build",
    "images": "node scripts/optimize-images.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "og": "tsx scripts/generate-og.tsx",
    "bitmaps": "tsx scripts/generate-bitmaps.tsx",
    "specimens": "tsx scripts/generate-specimens.tsx",
    "flora": "tsx scripts/generate-flora.tsx",
    "aquarium": "tsx scripts/generate-aquarium.tsx",
    "sea": "tsx scripts/generate-sea.tsx",
    "new-project": "node scripts/new-project.mjs",
    "refs": "node --env-file-if-exists=.env.local scripts/sync-refs.mjs",
    "scenes": "tsx scripts/generate-scenes.tsx"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.54.0",
    "matter-js": "^0.20.0",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "puppeteer": "^25.12.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
